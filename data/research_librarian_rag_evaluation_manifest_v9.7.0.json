{
  "schema": "sc-research-librarian-rag-evaluation-manifest/1.0",
  "release": "9.7.0",
  "name": "RAG Evaluation & Evidence-Grounding Framework",
  "depends_on": {
    "research_librarian": "9.6.0",
    "context_contract": "sc-research-librarian-ai-research-context/1.0"
  },
  "objects": [
