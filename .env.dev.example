# Development only. Generate fresh secrets; never copy production credentials.
SC_RL_ENVIRONMENT=development
SC_RL_BACKEND_API_KEY=GENERATE_UNIQUE_SECRET
SC_RL_DATABASE_BACKEND=sqlite
SC_RL_DB_PATH=/var/data/research_librarian.sqlite3
SC_RL_CORE_ENABLED=true
SC_RL_CORE_BASE_URL=http://sc-core:8090
SC_RL_CORE_WRITE_API_KEY=GENERATE_UNIQUE_SECRET
SC_RL_CORE_SUPPORTED_MAJOR=4
SC_RL_GEMINI_API_KEY=
SC_RL_DATA_DIR=/var/data/sc-research-librarian
SC_RL_AI_PROVIDER=disabled
SC_RL_CORS_ORIGINS=http://localhost:8081,http://localhost:8093
SC_RL_WORKBENCH_URL=http://localhost:8092/
SC_RL_DECISION_STUDIO_URL=http://localhost:18089/
SC_RL_SITE_INTELLIGENCE_URL=http://localhost:8091/
SC_RL_LAB_URL=http://localhost:18092/
SC_RL_FEATURE_SUGGESTIONS_URL=http://localhost:8081/feature-suggestions/
SC_DEV_WP_NETWORK=existing-wordpress-private-network
